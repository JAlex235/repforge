<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/boton_ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape>
                    <solid android:color="@color/boton_deshabilitado" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/boton_fondo" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
