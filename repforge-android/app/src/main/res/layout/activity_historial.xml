<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/nav_history" android:textAppearance="@style/TextAppearance.RepForge.Title" />
    <TextView android:id="@+id/estadoHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextAppearance.RepForge.Detail" />
    <Button android:id="@+id/reintentarHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/retry_profile" android:visibility="gone" />
    <Button android:id="@+id/volverHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/history_back" android:visibility="gone" />
    <ListView android:id="@+id/listaHistorial" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp" android:divider="@android:color/transparent"
        android:dividerHeight="12dp" android:visibility="gone" android:saveEnabled="false" />
    <ScrollView android:id="@+id/detalleHistorial" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="16dp" android:visibility="gone" android:saveEnabled="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="20dp" android:background="@drawable/tarjeta_inicio">
                <TextView android:id="@+id/nombreHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RepForge.Subtitle" />
                <TextView android:id="@+id/fechasHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textAppearance="@style/TextAppearance.RepForge.Detail" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="@string/history_duration" android:textAppearance="@style/TextAppearance.RepForge.Detail" />
                <TextView android:id="@+id/duracionHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RepForge.Timer" />
                <TextView android:id="@+id/resumenHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.RepForge.Detail" />
            </LinearLayout>
            <LinearLayout android:id="@+id/bloquesHistorial" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
