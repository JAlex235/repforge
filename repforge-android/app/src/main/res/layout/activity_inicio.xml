<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textAppearance="@style/TextAppearance.RepForge.Subtitle"
            android:textColor="@color/texto_secundario" />
        <LinearLayout
            android:id="@+id/estadoInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/progresoInicio"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal" />
            <TextView
                android:id="@+id/tvEstadoInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/loading_profile"
                android:textAppearance="@style/TextAppearance.RepForge.Body" />
            <Button
                android:id="@+id/btnReintentarInicio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/retry_profile"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/contenidoInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/tvSaludo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.RepForge.Title" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/home_intro"
                android:textAppearance="@style/TextAppearance.RepForge.Subtitle"
                android:textColor="@color/texto_secundario" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/tarjeta_inicio"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_strength_title"
                    android:textAppearance="@style/TextAppearance.RepForge.Title"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_training_description"
                    android:textAppearance="@style/TextAppearance.RepForge.Body" />
                <Button
                    android:id="@+id/btnIniciarEntrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/training_open" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/training_home"
                    android:textAppearance="@style/TextAppearance.RepForge.Detail"
                    android:textColor="@color/acento_secundario" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_aviso"
                android:drawablePadding="8dp"
                android:text="@string/preview_notice"
                android:textAppearance="@style/TextAppearance.RepForge.Detail" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
