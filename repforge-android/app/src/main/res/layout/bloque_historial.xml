<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginTop="16dp" android:padding="20dp" android:background="@drawable/tarjeta_inicio">
    <TextView android:id="@+id/nombreBloqueHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RepForge.Subtitle" />
    <TextView android:id="@+id/tipoBloqueHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.RepForge.Detail" />
    <TextView android:id="@+id/seriesHistorial" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:lineSpacingExtra="8dp" android:textAppearance="@style/TextAppearance.RepForge.Body" />
</LinearLayout>
