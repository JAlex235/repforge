<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:padding="20dp" android:minHeight="80dp" android:background="@drawable/tarjeta_inicio">
    <TextView android:id="@+id/nombreResumen" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.RepForge.Subtitle" />
    <TextView android:id="@+id/fechaResumen" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.RepForge.Detail" />
    <TextView android:id="@+id/cifrasResumen" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.RepForge.Body" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="@string/history_open" android:textAppearance="@style/TextAppearance.RepForge.Subtitle"
        android:textColor="@color/texto_principal" />
</LinearLayout>
