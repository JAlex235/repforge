<resources>
    <style name="TextAppearance.RepForge.Body" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="TextAppearance.RepForge.Detail" parent="TextAppearance.RepForge.Body">
        <item name="android:textColor">@color/texto_secundario</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.RepForge.Title" parent="TextAppearance.AppCompat.Headline">
        <item name="fontFamily">@font/oswald_600</item>
        <item name="android:fontFamily">@font/oswald_600</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="TextAppearance.RepForge.Timer" parent="TextAppearance.RepForge.Title">
        <item name="android:textSize">48sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.RepForge.Subtitle" parent="TextAppearance.AppCompat.Subhead">
        <item name="fontFamily">@font/montserrat_500</item>
        <item name="android:fontFamily">@font/montserrat_500</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
